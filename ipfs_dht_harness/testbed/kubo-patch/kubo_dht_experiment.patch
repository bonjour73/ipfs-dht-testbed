@@ -243,13 +244,38 @@ func ConstructDefaultRouting(cfg *config.Config, routingOpt RoutingOption) Routi
 // constructDHTRouting is used when Routing.Type = "dht"
 func constructDHTRouting(mode dht.ModeOpt) RoutingOption {
 	return func(args RoutingOptionArgs) (routing.Routing, error) {
+		// EXPERIMENT: α (query concurrency) and K (bucket size) are read from
+		// EXP_DHT_ALPHA / EXP_DHT_BUCKET_K so one binary sweeps the whole matrix.
+		alpha, bucketSize := config.DHTAlpha(), config.DHTBucketSize()
+		log.Infof("DHT experiment params: alpha=%d bucketSize=%d", alpha, bucketSize)
 		dhtOpts := []dht.Option{
-			dht.Concurrency(10),
+			dht.Concurrency(alpha),
+			dht.BucketSize(bucketSize),
 			dht.Mode(mode),
 			dht.Datastore(args.Datastore),
 			dht.ValueDatastore(irouting.DHTValueDatastore(args.Datastore)),
 			dht.Validator(args.Validator),
 		}
+		// EXPERIMENT: on a private/container testbed every peer sits on a
+		// private IP; the default public filters would reject them and leave the
+		// routing table empty. EXP_DHT_PRIVATE_NET=1 swaps in the private
+		// filters so the isolated DHT actually populates.
+		if config.DHTPrivateNet() {
+			prefix := config.DHTProtocolPrefix()
+			log.Infof("DHT experiment: private-net address filters enabled, protocol prefix=%s bucketSize=%d", prefix, bucketSize)
+			dhtOpts = append(dhtOpts,
+				dht.QueryFilter(dht.PrivateQueryFilter),
+				dht.RoutingTableFilter(dht.PrivateRoutingTableFilter),
+				// A custom (non-"/ipfs") protocol prefix is REQUIRED to use a
+				// bucket size other than 20: go-libp2p-kad-dht's Validate()
+				// enforces K==20 only when the prefix equals the Amino default.
+				// It also isolates the testbed from the public swarm at the
+				// protocol layer. Applied to both WAN and LAN children via the
+				// dual DHTOption, yielding e.g. /exp/kad/1.0.0 (WAN) and
+				// /exp/lan/kad/1.0.0 (LAN).
+				dht.ProtocolPrefix(protocol.ID(prefix)),
+			)
+		}
 		if args.OptimisticProvide {
 			dhtOpts = append(dhtOpts, dht.EnableOptimisticProvide())
 		}
